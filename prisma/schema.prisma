generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SwapMethod {
  WALK_IN
  HOME_PICKUP
  COURIER
}

enum ConditionType {
  BATTERY    @map("battery")
  SCREEN     @map("screen")
  FACE_ID    @map("faceid")
  BACK_GLASS @map("backglass")
  BODY       @map("body")
  SIM        @map("sim")
}

enum PriceModifierType {
  AMOUNT
  PERCENTAGE
}

enum SwapStatus {
  SUBMITTED
  INSPECTION_SCHEDULED
  UNDER_INSPECTION
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  REJECTED
  FULFILMENT_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SwapOfferStatus {
  ORIGINAL
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

// ─── Core swap models ─────────────────────────────────────────────────────────

model Swap {
  id     String     @id @default(cuid())
  status SwapStatus @default(SUBMITTED)

  // Trade-in phone (FK to the catalogued model)
  tradeInModelId String
  tradeInModel   PhoneModel @relation(fields: [tradeInModelId], references: [id])

  // Buying price snapshot at time of swap submission (immutable after creation)
  snapshotBuyingPrice Decimal @db.Decimal(12, 2)
  // Calculated trade-in value at submission (immutable historical snapshot)
  tradeInValue        Decimal @db.Decimal(12, 2)

  // Upgrade phone — FK to the selling-price record chosen at submission
  phoneSellingPriceId String
  phoneSellingPrice   PhoneSellingPrice @relation(fields: [phoneSellingPriceId], references: [id])

  // Upgrade phone category + device snapshots (immutable historical record)
  upgradeCategoryId String
  upgradeCategory   PhoneSaleCategory @relation(fields: [upgradeCategoryId], references: [id])
  upgradeModel      String
  upgradeStorage    String
  upgradePrice      Decimal @db.Decimal(12, 2) // price snapshot at time of swap submission

  // Current financial values (updated when revised offer is created/accepted)
  currentTradeInValue Decimal @db.Decimal(12, 2)
  currentUpgradePrice Decimal @db.Decimal(12, 2)
  amountToPay         Decimal @db.Decimal(12, 2)

  // How the swap will be completed
  swapMethod SwapMethod

  // Contact — single source of truth
  contactName  String?
  contactEmail String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  conditions  SwapCondition[]
  appointment Appointment?
  offers      SwapOffer[]
  auditLogs   SwapAuditLog[]
}

// One row per condition attribute answered during the trade-in flow
model SwapCondition {
  id       String @id @default(cuid())
  swapId   String
  swap     Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)
  groupKey ConditionType
  value    String // e.g. "80-89", "good", "not-working"

  @@unique([swapId, groupKey])
}

model Appointment {
  id         String     @id @default(cuid())
  swapId     String     @unique
  swap       Swap       @relation(fields: [swapId], references: [id])
  swapMethod SwapMethod
  date       DateTime
  time       String
  createdAt  DateTime   @default(now())
  // Contact fields removed — they live on Swap
}

// ─── Phone catalogue ──────────────────────────────────────────────────────────

model PhoneModel {
  id          String   @id @default(cuid())
  label       String // e.g. "iPhone 15 Pro 256GB"
  model       String // e.g. "iPhone 15 Pro"
  storage     String // e.g. "256GB"
  buyingPrice Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  swaps         Swap[]
  sellingPrices PhoneSellingPrice[]
}

model PhoneSaleCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  imagePath   String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices PhoneSellingPrice[]
  swaps  Swap[]
}

model PhoneSellingPrice {
  id           String            @id @default(cuid())
  categoryId   String
  category     PhoneSaleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  phoneModelId String
  phoneModel   PhoneModel        @relation(fields: [phoneModelId], references: [id], onDelete: Cascade)
  price        Decimal           @db.Decimal(12, 2)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  swaps Swap[]

  @@unique([categoryId, phoneModelId])
}

// ─── Swap lifecycle ───────────────────────────────────────────────────────────

model SwapOffer {
  id     String @id @default(cuid())
  swapId String
  swap   Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)

  tradeInValue Decimal @db.Decimal(12, 2)
  upgradePrice Decimal @db.Decimal(12, 2)
  amountToPay  Decimal @db.Decimal(12, 2)
  reason       String?
  status       SwapOfferStatus @default(ORIGINAL)

  // Secure expiring token for customer email accept/reject links (null for ORIGINAL offers)
  responseToken          String?   @unique
  responseTokenExpiresAt DateTime?

  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Append-only audit log — no updates or deletes permitted via the application layer
model SwapAuditLog {
  id     String @id @default(cuid())
  swapId String
  swap   Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)

  // Null when the action is performed by the customer or the system
  adminId  String?

  action   String
  field    String?
  oldValue String?
  newValue String?
  reason   String?

  createdAt DateTime @default(now())
}

// ─── Condition attribute system ───────────────────────────────────────────────

model ConditionAttributeGroup {
  id          String                     @id @default(cuid())
  key         ConditionType              @unique
  label       String
  description String?
  isActive    Boolean                    @default(true)
  order       Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  options     ConditionAttributeOption[]
}

model ConditionAttributeOption {
  id            String                  @id @default(cuid())
  groupId       String
  group         ConditionAttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  imagePath     String?
  priceModifier Float                   @default(1.0)
  modifierType  PriceModifierType       @default(AMOUNT)
  isActive      Boolean                 @default(true)
  order         Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([groupId, label])
}
