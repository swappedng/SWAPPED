generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SwapMethod {
  WALK_IN
  HOME_PICKUP
  COURIER
}

// ─── Core swap models ─────────────────────────────────────────────────────────

model Swap {
  id    String @id @default(cuid())

  // Trade-in phone (FK to the catalogued model)
  tradeInModelId String
  tradeInModel   PhoneModel @relation(fields: [tradeInModelId], references: [id])
  tradeInValue   Float

  // Upgrade phone
  upgradeCategoryId String
  upgradeCategory   PhoneSaleCategory @relation(fields: [upgradeCategoryId], references: [id])
  upgradeModel      String
  upgradeStorage    String
  upgradePrice      Float // price snapshot at time of swap

  // Financials
  amountToPay Float

  // How the swap will be completed
  swapMethod SwapMethod

  // Contact — single source of truth
  contactName  String?
  contactEmail String?
  contactPhone String?

  createdAt DateTime @default(now())

  // Relations
  conditions  SwapCondition[]
  appointment Appointment?
}

// One row per condition attribute answered during the trade-in flow
model SwapCondition {
  id       String @id @default(cuid())
  swapId   String
  swap     Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)
  groupKey String // e.g. "battery", "screen", "faceid"
  value    String // e.g. "80-89", "good", "not-working"

  @@unique([swapId, groupKey])
}

model Appointment {
  id              String   @id @default(cuid())
  swapId          String   @unique
  swap            Swap     @relation(fields: [swapId], references: [id])
  appointmentType String
  date            DateTime
  time            String
  createdAt       DateTime @default(now())
  // Contact fields removed — they live on Swap
}

// ─── Phone catalogue ──────────────────────────────────────────────────────────

model PhoneModel {
  id        String   @id @default(cuid())
  label     String // e.g. "iPhone 15 Pro 256GB"
  value     String   @unique // e.g. "15pro-256" (slug used in trade-in flow)
  model     String // e.g. "iPhone 15 Pro"
  storage   String // e.g. "256GB"
  basePrice Float
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swaps         Swap[]
  sellingPrices PhoneSellingPrice[]
}

model PhoneSaleCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  imagePath   String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices PhoneSellingPrice[]
  swaps  Swap[]
}

model PhoneSellingPrice {
  id           String            @id @default(cuid())
  categoryId   String
  category     PhoneSaleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  phoneModelId String
  phoneModel   PhoneModel        @relation(fields: [phoneModelId], references: [id])
  model        String // denormalised for catalogue display
  storage      String
  price        Float
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([categoryId, model, storage])
}

// ─── Condition attribute system ───────────────────────────────────────────────

model ConditionAttributeGroup {
  id          String                     @id @default(cuid())
  key         String                     @unique // "battery", "screen", "faceid", "backglass", "sim"
  label       String
  description String?
  isActive    Boolean                    @default(true)
  order       Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  options     ConditionAttributeOption[]
}

model ConditionAttributeOption {
  id                 String                  @id @default(cuid())
  groupId            String
  group              ConditionAttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value              String
  label              String
  description        String?
  displayLabel       String?
  displayDescription String?
  imagePath          String?
  priceModifier      Float                   @default(1.0)
  modifierType       String                  @default("AMOUNT") // Can be "AMOUNT" or "PERCENTAGE"
  isActive           Boolean                 @default(true)
  order              Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([groupId, value])
}
